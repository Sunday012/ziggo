# Clerk authentication (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# OpenRouter chat completion (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon PostgreSQL persistence (server-side secret — never prefix with NEXT_PUBLIC_)
DATABASE_URL=

# Pinecone integrated-embedding knowledge index
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ziggo-knowledge

# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# Google Cloud OAuth web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta WhatsApp Cloud API
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v24.0
